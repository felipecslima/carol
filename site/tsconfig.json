{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@app/*": ["./src/app/*"],
      "@blocks/*": ["./src/blocks/*"],
      "@themes/*": ["./src/themes/*"],
      "@lib/*": ["./src/lib/*"],
      "@server/*": ["./src/server/*"]
    }
  }
}
