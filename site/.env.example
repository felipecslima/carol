# Copie para .env (local, fora do Git) e preencha. Em produção os segredos entram com `wrangler secret put NOME`;
# as variáveis PUBLIC_* não são segredo e podem ficar em `vars` no wrangler.jsonc ou no .env.production.
# O schema de todas está em astro.config.mjs (env.schema).

# ---- Públicas: vão para o navegador ----
# Supabase: Project Settings → API. A chave anon só funciona com RLS ligada em todas as tabelas.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Cloudinary: nome da conta (já aparece nas URLs). Fica versionado em .env.production.
PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Segredos: só no servidor, nunca no navegador nem no Git ----
# Supabase service role: ignora a RLS. Só em código de src/server/.
SUPABASE_SERVICE_ROLE_KEY=
# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME (também usada por scripts/cloudinary-upload.mjs)
CLOUDINARY_URL=
# Aviso interno no Slack (incoming webhook)
SLACK_WEBHOOK_URL=
# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=
# Provedor de IA
AI_API_KEY=
