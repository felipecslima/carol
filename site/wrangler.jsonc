{
  "name": "carol",
  "compatibility_date": "2026-10-01",
  // src/server/worker.ts: redirects www/http → https e 404 por idioma, por cima do adapter (@astrojs/cloudflare).
  // A pasta dos arquivos estáticos (dist/client) vem do adapter no `astro build`.
  "main": "./src/server/worker.ts",
  "assets": {
    "binding": "ASSETS",
    // o redirecionamento precisa ver toda requisição, inclusive as de arquivos
    "run_worker_first": true,
    // dist/client/404.html (src/pages/404.astro) com status 404
    "not_found_handling": "404-page"
  }
}
