---
// Rodapé comum. Os links de nicho também servem de ligação interna para a busca.
import { SOCIAL } from '../data/content';
import { NICHES } from '../data/niches';

---
<footer>
  <div class="wrap">
    <a class="logo" href="/">Carol <i>Limah</i></a>
    <ul class="foot-niches" aria-label="Portfólio por tema">
      {NICHES.map((n) => <li><a href={`/${n.slug}/`}>{n.label}</a></li>)}
    </ul>
    <ul class="foot-social" aria-label="Redes sociais">
      {SOCIAL.map((l) => <li><a href={l.href} target="_blank" rel="me noopener">{l.label}</a></li>)}
    </ul>
    <span>© 2026 Carol Limah · São Paulo, SP</span>
  </div>
</footer>
