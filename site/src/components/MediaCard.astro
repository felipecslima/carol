---
// Card 9:16 do portfólio (home e páginas de nicho). Abre o lightbox via scripts/lightbox.ts.
import { CAT_LABEL, groupsOf, posterSrc, videoSrc, type MediaItem } from '../data/content';
import { num, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  m: MediaItem;
  lang: Lang;
  sizes?: string;
  /** páginas de nicho: sem rótulo de categoria e sem selo de marca quando a parada já tem o nome dela */
  bare?: boolean;
  hideBrand?: boolean;
}
const { m, lang, sizes = '(max-width: 720px) 50vw, 300px', bare = false, hideBrand = false } = Astro.props;
const t = UI[lang];
const title = m.title[lang];
const views = m.views && num(m.views, lang);
const photoSrcset = (id: string) => `/media/${id}-600.webp 600w, /media/${id}.webp 1100w`;
---
<button
  class="card" type="button"
  data-cat={CAT_LABEL[m.cat][lang]} data-groups={groupsOf(m).join(' ')} data-title={title} data-brand={m.brand ?? ''}
  data-video={m.video ? '1' : '0'} data-id={m.id} data-views={views || ''}
>
  {m.video
    // capa num <img loading="lazy">: só baixa perto da tela (o poster do <video> baixaria todas de uma vez).
    // O vídeo fica por cima, invisível até começar a tocar no hover (scripts/lightbox.ts).
    ? <Fragment>
        <img class="media" src={posterSrc(m.id)} srcset={`${posterSrc(m.id)} 360w, ${posterSrc(m.id, 720)} 720w`} sizes={sizes} alt={t.videoCover(title)} aria-hidden="true" loading="lazy" decoding="async" />
        <video src={`${videoSrc(m.id)}#t=0.8`} muted loop playsinline preload="none" aria-hidden="true"></video>
      </Fragment>
    : <img class="media" src={`/media/${m.id}.webp`} srcset={photoSrcset(m.id)} sizes={sizes} alt={t.photo(title)} loading="lazy" />}
  <div class="shade"></div>
  <!-- o nome do botão é o próprio texto visível (WCAG 2.5.3); o que só o leitor de tela precisa vai em sr-only -->
  <div class="cap">
    {m.video && <span class="sr-only">{t.video}: </span>}<strong>{title}</strong>
    {views ? (
      <span class="views">
        <svg aria-hidden="true"><use href="#i-eye" /></svg>
        {views} {t.views}
      </span>
    ) : <span class="views" aria-hidden="true" style="visibility: hidden">&nbsp;</span>}
  </div>
  {m.brand && (hideBrand
    ? <span class="sr-only">, {t.partnerWith} {m.brand}</span>
    : <span class="brand"><span class="sr-only">, {t.partnerWith} </span>{m.brand}</span>)}
  {m.video && (
    <span class="play" aria-hidden="true">
      <svg><use href="#i-play" /></svg>
    </span>
  )}
</button>
