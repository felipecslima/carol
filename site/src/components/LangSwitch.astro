---
// Seletor de idioma da nav: sempre visível (no mobile fica ao lado do menu, fora dele).
// Cada link leva à mesma página no outro idioma.
import { LANGS, LANG_NAME, LOCALE, type L, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** caminho desta página em cada idioma */
  alternates: L;
}
const { lang, alternates } = Astro.props;
---
<ul class="lang" aria-label={UI[lang].language}>
  {LANGS.map((l) => (
    <li>
      <a href={alternates[l]} hreflang={LOCALE[l]} lang={LOCALE[l]} aria-current={l === lang ? 'true' : undefined}>
        {l.toUpperCase()}<span class="sr-only"> {LANG_NAME[l]}</span>
      </a>
    </li>
  ))}
</ul>
