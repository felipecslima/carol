---
// <head> comum: título, descrição, canonical, versões em outros idiomas, prévia de link e JSON-LD.
// URLs absolutas vêm do `site` em astro.config.mjs.
import { CLOUDINARY_ORIGIN } from '../data/content';
import { LANGS, LOCALE, OG_LOCALE, type L, type Lang } from '../i18n';
import { UI } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** caminho desta página em cada idioma, ex. { pt: '/viagens-e-hospedagem/', en: '/en/travel-and-stays/', … } */
  alternates: L;
  ogType?: string;
  jsonLd?: object;
  /** páginas fora da busca (404): sem canonical nem prévia de link */
  noindex?: boolean;
}
const { lang, title, description, alternates, ogType = 'website', jsonLd, noindex = false } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const canonical = abs(alternates[lang]);
// prévia de link com o título no idioma (gerada por `npm run og`)
const ogImage = abs(`/og-${lang}.jpg`);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <Fragment>
<link rel="canonical" href={canonical} />
{LANGS.map((l) => <link rel="alternate" hreflang={LOCALE[l]} href={abs(alternates[l])} />)}
<link rel="alternate" hreflang="x-default" href={abs(alternates.pt)} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Carol Limah" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={UI[lang].ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
</Fragment>}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<meta name="theme-color" content="#17110d" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{CLOUDINARY_ORIGIN && <link rel="preconnect" href={CLOUDINARY_ORIGIN} />}
<!-- o título do hero é o maior elemento da primeira tela: a serif chega junto com o HTML -->
<link rel="preload" href="/fonts/instrument-serif-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
<!-- Amplitude: a chave é a pública do projeto (só envia eventos), por isso fica no HTML -->
<script is:inline src="https://cdn.amplitude.com/script/86c8a9bc2c7bbeb3e38d5662653bbf02.js"></script>
<script is:inline>
  window.amplitude.add(window.sessionReplay.plugin({ sampleRate: 1, serverZone: 'US' }));
  window.amplitude.init('86c8a9bc2c7bbeb3e38d5662653bbf02', {
    serverZone: 'US',
    autocapture: true,
  });
</script>
