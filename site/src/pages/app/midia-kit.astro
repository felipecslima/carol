---
// Mídia kit do Portfólio Creator em 1 página A4 (rota de impressão); fora da busca. A marca d'água de teste sai
// quando a conta tem um plano pago (MidiaKit.tsx).
import '../../styles/global.css';
import '../../blocks/blocos.css';
import MonitorDeErros from '../../components/MonitorDeErros.astro';
import SeoHead from '../../components/SeoHead.astro';
import MidiaKit from '@app/midia-kit/MidiaKit';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      lang="pt"
      title="Portfólio Creator: mídia kit"
      description="Mídia kit em PDF."
      alternates={{ pt: '/app/midia-kit/' }}
      noindex
      analytics={false}
      themeColor="#ffffff"
    />
    <MonitorDeErros />
  </head>
  <body style="margin:0">
    <MidiaKit client:only="react" />
  </body>
</html>
