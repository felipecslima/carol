---
// Páginas de nicho para a busca: o nicho é um roteiro de paradas (lugar, casa ou marca), cada uma com seus vídeos.
// O índice do roteiro acompanha a rolagem (scripts/niche.ts). Conteúdo em data/niches.ts.
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import MediaCard from '../components/MediaCard.astro';
import Lightbox from '../components/Lightbox.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { EMAIL, MAILTO, MEDIA_KIT_PDF, RESPONSE_TIME } from '../data/content';
import { NICHES, stopMedia, topViews, type Niche } from '../data/niches';

export function getStaticPaths() {
  return NICHES.map((niche) => ({ params: { nicho: niche.slug }, props: { niche } }));
}

const { niche } = Astro.props as { niche: Niche };
const path = `/${niche.slug}/`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const plural = (n: number) => `${n} ${n === 1 ? 'vídeo' : 'vídeos'}`;
const stops = niche.stops.map((s) => ({ ...s, media: stopMedia(s), top: topViews(s) }));
// o selo de marca some quando repete o nome da parada ("Kome Bela Vista" na parada "Kome")
const sameName = (a: string, b: string) => a.toLowerCase().includes(b.toLowerCase()) || b.toLowerCase().includes(a.toLowerCase());
const others = NICHES.filter((n) => n.slug !== niche.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      url: abs(path),
      name: niche.title,
      description: niche.description,
      inLanguage: 'pt-BR',
      about: { '@id': `${abs('/')}#carol` },
      isPartOf: { '@type': 'WebSite', url: abs('/'), name: 'Carol Limah' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Carol Limah', item: abs('/') },
        { '@type': 'ListItem', position: 2, name: niche.label, item: abs(path) },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title={niche.title} description={niche.description} path={path} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <nav class="nav" aria-label="Principal">
      <div class="wrap">
        <a class="logo" href="/">Carol <i>Limah</i></a>
        <button class="burger" type="button" id="burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
        <div class="nav-links" id="nav-links">
          {NICHES.map((n) => <a href={`/${n.slug}/`} aria-current={n.slug === niche.slug ? 'page' : undefined}>{n.label}</a>)}
          <a class="cta" href="#contato">Quero uma parceria</a>
        </div>
        <a class="route-now" id="route-now" href="#route" hidden><span class="route-now-dot" aria-hidden="true"></span><b id="route-now-name"></b><small id="route-now-count"></small></a>
      </div>
    </nav>

    <main id="conteudo" tabindex="-1" class="wrap nx">
      <header class="nx-intro">
        <nav class="crumbs" aria-label="Trilha">
          <ol><li><a href="/">Carol Limah</a></li><li aria-current="page">{niche.label}</li></ol>
        </nav>
        <h1 class="h1" set:html={niche.h1} />
        <p class="hero-lead">{niche.lead}</p>
        <div class="btns">
          <a class="btn btn-primary" href={MAILTO}>Quero uma parceria</a>
          <a class="btn btn-outline" href={MEDIA_KIT_PDF} download>Baixar media kit (PDF)</a>
        </div>
      </header>

      <aside class="route-wrap">
        <nav class="route" id="route" aria-label="Paradas deste roteiro">
          <ol>
            {stops.map((s) => (
              <li>
                <a href={`#${s.id}`}>
                  <b>{s.name}</b>
                  <small>{plural(s.media.length)}{s.top && ` · até ${s.top} views`}</small>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <div class="stops">
        {stops.map((s) => (
          <section class="stop" id={s.id} aria-labelledby={`${s.id}-t`}>
            <div class="stop-head">
              <h2 class="stop-name" id={`${s.id}-t`}>{s.name}</h2>
              <p class="stop-text">{s.where && <span class="stop-where">{s.where}. </span>}{s.text}</p>
            </div>
            <div class="stop-grid">
              {s.media.map((m) => (
                <MediaCard m={m} sizes="(max-width: 720px) 62vw, 240px" bare hideBrand={!!m.brand && sameName(m.brand, s.name)} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </main>

    <section class="nx-more" aria-labelledby="mais-t">
      <div class="wrap">
        <h2 class="nx-more-t" id="mais-t">Outros <em>roteiros</em></h2>
        <ul class="nx-more-list">
          {others.map((n) => <li><a href={`/${n.slug}/`}><b>{n.label}</b><span>{n.stops.map((s) => s.name).join(' · ')}</span></a></li>)}
          <li><a href="/#portfolio"><b>Portfólio completo</b><span>Todos os vídeos, resultados e público</span></a></li>
        </ul>
      </div>
    </section>

    <section id="contato" class="contact">
      <div class="wrap">
        <h2 class="h2">Bora levar a sua marca pra <em>um lugar incrível?</em></h2>
        <a class="mail-btn" href={MAILTO}>Escrever e-mail</a>
        <p class="contact-addr"><span>{EMAIL}</span></p>
        <p class="contact-time nx-time">{RESPONSE_TIME}</p>
        <div class="contact-actions">
          <a class="kit-btn" href={MEDIA_KIT_PDF} download>Baixar media kit (PDF)</a>
        </div>
      </div>
    </section>

    <Lightbox />
    <SiteFooter />

    <script>
      import '../scripts/niche';
    </script>
  </body>
</html>
