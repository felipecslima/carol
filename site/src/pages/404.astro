---
// Servida pelo Cloudflare com status 404 (not_found_handling em wrangler.jsonc).
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { NICHES } from '../data/niches';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead title="Página não encontrada · Carol Limah" description="Essa página não existe. Veja o portfólio da Carol Limah." path="/404" noindex />
  </head>
  <body>
    <nav class="nav" aria-label="Principal">
      <div class="wrap">
        <a class="logo" href="/">Carol <i>Limah</i></a>
      </div>
    </nav>
    <main class="wrap nf">
      <h1 class="h1">Essa página <em>se perdeu no caminho.</em></h1>
      <p class="hero-lead">O endereço pode ter mudado ou nunca ter existido. Daqui dá pra seguir por um destes:</p>
      <ul class="nx-more-list">
        <li><a href="/"><b>Início</b><span>Portfólio, resultados e contato</span></a></li>
        {NICHES.map((n) => <li><a href={`/${n.slug}/`}><b>{n.label}</b><span>{n.stops.map((s) => s.name).join(' · ')}</span></a></li>)}
      </ul>
    </main>
    <SiteFooter />
  </body>
</html>
